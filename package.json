{
  "name": "cut-the-traffic",
  "private": true,
  "version": "0.1.0",
  "description": "Mobile-first casual traffic-management game (Phaser 3 + Vite + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  }
}
